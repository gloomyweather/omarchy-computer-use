#!/usr/bin/env bash
# omarchy-cu — computer use for Omarchy/Hyprland. Works from a symlink too.
src="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../src"
exec env PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}" python3 -I -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from omarchy_cu.cli import main; sys.exit(main(sys.argv[1:]))' "$src" "$@"
